import {
  DialogRoot as BaseDialogRoot,
  DialogTrigger as BaseDialogTrigger,
  DialogPopup as BaseDialogPopup,
  DialogTitle as BaseDialogTitle,
  DialogDescription as BaseDialogDescription,
  DialogClose as BaseDialogClose,
} from "../bisque/dialog/dialog.rx"
import { DivProps } from "../bisque/internal/types.rx"
import { ButtonStyle } from "./button.rx"

export component DialogRoot(props: Parameters<typeof BaseDialogRoot>[0]) {
  <BaseDialogRoot {...props}>{props.children}</BaseDialogRoot>
}

export component DialogTrigger({ variant = "outline", tone = "default", size = "default", children, ...rest }: Parameters<typeof BaseDialogTrigger>[0] & ButtonStyle) {
  <BaseDialogTrigger {...rest} data-glaze="dialog-trigger" data-variant={variant} data-tone={tone} data-size={size}>{children}</BaseDialogTrigger>
}

export component DialogPopup(props: Parameters<typeof BaseDialogPopup>[0]) {
  <BaseDialogPopup {...props} data-glaze="dialog-popup">{props.children}</BaseDialogPopup>
}

export component DialogTitle(props: Parameters<typeof BaseDialogTitle>[0]) {
  <BaseDialogTitle {...props} data-glaze="dialog-title">{props.children}</BaseDialogTitle>
}

export component DialogDescription(props: Parameters<typeof BaseDialogDescription>[0]) {
  <BaseDialogDescription {...props} data-glaze="dialog-description">{props.children}</BaseDialogDescription>
}

export component DialogClose({ variant = "outline", tone = "default", size = "default", children, ...rest }: Parameters<typeof BaseDialogClose>[0] & ButtonStyle) {
  <BaseDialogClose {...rest} data-glaze="dialog-close" data-variant={variant} data-tone={tone} data-size={size}>{children}</BaseDialogClose>
}

// A Glaze addition with no Bisque part: the row of actions that ends the popup. Put the primary action last.
export component DialogFooter({ children, ...rest }: DivProps) {
  <div {...rest} data-glaze="dialog-footer">{children}</div>
}
