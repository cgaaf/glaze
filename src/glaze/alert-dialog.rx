import {
  AlertDialogRoot as BaseAlertDialogRoot,
  AlertDialogTrigger as BaseAlertDialogTrigger,
  AlertDialogPopup as BaseAlertDialogPopup,
  AlertDialogTitle as BaseAlertDialogTitle,
  AlertDialogDescription as BaseAlertDialogDescription,
  AlertDialogClose as BaseAlertDialogClose,
} from "../bisque/alert-dialog/alert-dialog.rx"
import { DivProps } from "../bisque/internal/types.rx"
import { ButtonStyle } from "./button.rx"

export component AlertDialogRoot(props: Parameters<typeof BaseAlertDialogRoot>[0]) {
  <BaseAlertDialogRoot {...props}>{props.children}</BaseAlertDialogRoot>
}

export component AlertDialogTrigger({ variant = "outline", tone = "default", size = "default", children, ...rest }: Parameters<typeof BaseAlertDialogTrigger>[0] & ButtonStyle) {
  <BaseAlertDialogTrigger {...rest} data-glaze="alert-dialog-trigger" data-variant={variant} data-tone={tone} data-size={size}>{children}</BaseAlertDialogTrigger>
}

export component AlertDialogPopup(props: Parameters<typeof BaseAlertDialogPopup>[0]) {
  <BaseAlertDialogPopup {...props} data-glaze="alert-dialog-popup">{props.children}</BaseAlertDialogPopup>
}

export component AlertDialogTitle(props: Parameters<typeof BaseAlertDialogTitle>[0]) {
  <BaseAlertDialogTitle {...props} data-glaze="alert-dialog-title">{props.children}</BaseAlertDialogTitle>
}

export component AlertDialogDescription(props: Parameters<typeof BaseAlertDialogDescription>[0]) {
  <BaseAlertDialogDescription {...props} data-glaze="alert-dialog-description">{props.children}</BaseAlertDialogDescription>
}

export component AlertDialogClose({ variant = "outline", tone = "default", size = "default", children, ...rest }: Parameters<typeof BaseAlertDialogClose>[0] & ButtonStyle) {
  <BaseAlertDialogClose {...rest} data-glaze="alert-dialog-close" data-variant={variant} data-tone={tone} data-size={size}>{children}</BaseAlertDialogClose>
}

// A Glaze addition with no Bisque part: the row of actions that ends the popup. Put the primary action last.
export component AlertDialogFooter({ children, ...rest }: DivProps) {
  <div {...rest} data-glaze="alert-dialog-footer">{children}</div>
}
