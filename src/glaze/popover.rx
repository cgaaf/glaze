import {
  PopoverRoot as BasePopoverRoot,
  PopoverTrigger as BasePopoverTrigger,
  PopoverPopup as BasePopoverPopup,
  PopoverTitle as BasePopoverTitle,
  PopoverDescription as BasePopoverDescription,
  PopoverClose as BasePopoverClose,
  PopoverArrow as BasePopoverArrow,
} from "../bisque/popover/popover.rx"
import { DivProps } from "../bisque/internal/types.rx"
import { ButtonStyle } from "./button.rx"

export component PopoverRoot(props: Parameters<typeof BasePopoverRoot>[0]) {
  <BasePopoverRoot {...props}>{props.children}</BasePopoverRoot>
}

export component PopoverTrigger({ variant = "outline", size = "default", children, ...rest }: Parameters<typeof BasePopoverTrigger>[0] & ButtonStyle) {
  <BasePopoverTrigger {...rest} data-glaze="popover-trigger" data-variant={variant} data-size={size}>{children}</BasePopoverTrigger>
}

export component PopoverPopup(props: Parameters<typeof BasePopoverPopup>[0]) {
  <BasePopoverPopup {...props} data-glaze="popover-popup">{props.children}</BasePopoverPopup>
}

export component PopoverTitle(props: Parameters<typeof BasePopoverTitle>[0]) {
  <BasePopoverTitle {...props} data-glaze="popover-title">{props.children}</BasePopoverTitle>
}

export component PopoverDescription(props: Parameters<typeof BasePopoverDescription>[0]) {
  <BasePopoverDescription {...props} data-glaze="popover-description">{props.children}</BasePopoverDescription>
}

export component PopoverClose({ variant = "outline", size = "default", children, ...rest }: Parameters<typeof BasePopoverClose>[0] & ButtonStyle) {
  <BasePopoverClose {...rest} data-glaze="popover-close" data-variant={variant} data-size={size}>{children}</BasePopoverClose>
}

export component PopoverArrow(props: Parameters<typeof BasePopoverArrow>[0]) {
  <BasePopoverArrow {...props} data-glaze="popover-arrow">{props.children}</BasePopoverArrow>
}

// A Glaze addition with no Bisque part: the row of actions that ends the popup. Put the primary action last.
export component PopoverFooter({ children, ...rest }: DivProps) {
  <div {...rest} data-glaze="popover-footer">{children}</div>
}
