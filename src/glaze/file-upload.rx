import {
  FileUploadRoot as BaseFileUploadRoot,
  FileUploadInput as BaseFileUploadInput,
  FileUploadTrigger as BaseFileUploadTrigger,
  FileUploadDropZone as BaseFileUploadDropZone,
  FileUploadItem as BaseFileUploadItem,
  FileUploadItemRemove as BaseFileUploadItemRemove,
  FileUploadItemPreview as BaseFileUploadItemPreview,
} from "../bisque/file-upload/file-upload.rx"

export component FileUploadRoot(props: Parameters<typeof BaseFileUploadRoot>[0]) {
  <BaseFileUploadRoot {...props} data-glaze="file-upload-root">{props.children}</BaseFileUploadRoot>
}

export component FileUploadInput(props: Parameters<typeof BaseFileUploadInput>[0]) {
  <BaseFileUploadInput {...props} data-glaze="file-upload-input" />
}

export component FileUploadTrigger(props: Parameters<typeof BaseFileUploadTrigger>[0]) {
  <BaseFileUploadTrigger {...props} data-glaze="file-upload-trigger">{props.children}</BaseFileUploadTrigger>
}

export component FileUploadDropZone(props: Parameters<typeof BaseFileUploadDropZone>[0]) {
  <BaseFileUploadDropZone {...props} data-glaze="file-upload-drop-zone">{props.children}</BaseFileUploadDropZone>
}

export component FileUploadItem(props: Parameters<typeof BaseFileUploadItem>[0]) {
  <BaseFileUploadItem {...props} data-glaze="file-upload-item">{props.children}</BaseFileUploadItem>
}

export component FileUploadItemRemove(props: Parameters<typeof BaseFileUploadItemRemove>[0]) {
  <BaseFileUploadItemRemove {...props} data-glaze="file-upload-item-remove">{props.children}</BaseFileUploadItemRemove>
}

export component FileUploadItemPreview(props: Parameters<typeof BaseFileUploadItemPreview>[0]) {
  <BaseFileUploadItemPreview {...props} data-glaze="file-upload-item-preview" />
}
