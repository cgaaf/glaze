import { Button as BaseButton } from "../bisque/button/button.rx"

// The emphasis and size shared by Button and every part that renders a button: triggers, close buttons, toast actions.
export type ButtonStyle = {
  variant?: "default" | "secondary" | "outline" | "ghost" | "destructive" | "link"
  size?: "default" | "sm" | "lg" | "icon"
}

export type ButtonProps = Parameters<typeof BaseButton>[0] & ButtonStyle

export component Button({ variant = "default", size = "default", children, ...rest }: ButtonProps) {
  <BaseButton {...rest} data-glaze="button" data-variant={variant} data-size={size}>{children}</BaseButton>
}
