import {
  SortableGroup as BaseSortableGroup,
  SortableRoot as BaseSortableRoot,
  SortableItem as BaseSortableItem,
  SortableHandle as BaseSortableHandle,
} from "../bisque/sortable/sortable.rx"

export component SortableGroup(props: Parameters<typeof BaseSortableGroup>[0]) {
  // Keep fallible controlled values separate from the spread of element attributes.
  { value, disabled, children, ...rest } = props
  attributes = rest catch (error) => ({})
  <BaseSortableGroup {...attributes} value={props.value} disabled={props.disabled} data-glaze="sortable-group">{props.children}</BaseSortableGroup>
}

export component SortableRoot(props: Parameters<typeof BaseSortableRoot>[0]) {
  // Keep fallible controlled values separate from the spread of element attributes.
  { value, disabled, children, ...rest } = props
  attributes = rest catch (error) => ({})
  <BaseSortableRoot {...attributes} value={props.value} disabled={props.disabled} data-glaze="sortable-root">{props.children}</BaseSortableRoot>
}

export component SortableItem(props: Parameters<typeof BaseSortableItem>[0]) {
  <BaseSortableItem {...props} data-glaze="sortable-item">{props.children}</BaseSortableItem>
}

export component SortableHandle(props: Parameters<typeof BaseSortableHandle>[0]) {
  <BaseSortableHandle {...props} data-glaze="sortable-handle">{props.children}</BaseSortableHandle>
}
