import {
  CheckboxRoot as BaseCheckboxRoot,
  CheckboxIndicator as BaseCheckboxIndicator,
} from "../bisque/checkbox/checkbox.rx"

export component CheckboxRoot(props: Parameters<typeof BaseCheckboxRoot>[0]) {
  // Keep fallible controlled values separate from the spread of element attributes.
  attributes = props catch (error) => ({})
  <span data-glaze="checkbox-shell">
    <BaseCheckboxRoot {...attributes} checked={props.checked} disabled={props.disabled} indeterminate={props.indeterminate} data-glaze="checkbox-root">{props.children}</BaseCheckboxRoot>
  </span>
}

export component CheckboxIndicator(props: Parameters<typeof BaseCheckboxIndicator>[0]) {
  <BaseCheckboxIndicator {...props} data-glaze="checkbox-indicator">{props.children}</BaseCheckboxIndicator>
}
