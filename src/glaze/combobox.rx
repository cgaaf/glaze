import {
  InputListRoot as BaseInputListRoot,
  ComboboxRoot as BaseComboboxRoot,
  ComboboxInput as BaseComboboxInput,
  ComboboxTrigger as BaseComboboxTrigger,
  ComboboxClear as BaseComboboxClear,
  ComboboxValue as BaseComboboxValue,
  ComboboxPopup as BaseComboboxPopup,
  ComboboxList as BaseComboboxList,
  ComboboxItem as BaseComboboxItem,
  ComboboxItemIndicator as BaseComboboxItemIndicator,
  ComboboxGroup as BaseComboboxGroup,
  ComboboxGroupLabel as BaseComboboxGroupLabel,
  ComboboxEmpty as BaseComboboxEmpty,
  ComboboxStatus as BaseComboboxStatus,
  ComboboxSeparator as BaseComboboxSeparator,
  ComboboxChips as BaseComboboxChips,
  ComboboxChip as BaseComboboxChip,
  ComboboxChipRemove as BaseComboboxChipRemove,
  ComboboxArrow as BaseComboboxArrow,
} from "../bisque/combobox/combobox.rx"

export component InputListRoot(props: Parameters<typeof BaseInputListRoot>[0]) {
  <BaseInputListRoot
    kind={props.kind}
    mode={props.mode}
    value={props.value}
    defaultValue={props.defaultValue}
    onValueChange={props.onValueChange}
    multiple={props.multiple}
    values={props.values}
    defaultValues={props.defaultValues}
    onValuesChange={props.onValuesChange}
    inputValue={props.inputValue}
    defaultInputValue={props.defaultInputValue}
    onInputValueChange={props.onInputValueChange}
    open={props.open}
    defaultOpen={props.defaultOpen}
    onOpenChange={props.onOpenChange}
    filter={props.filter}
    autoHighlight={props.autoHighlight}
    loop={props.loop}
    openOnInputClick={props.openOnInputClick}
    disabled={props.disabled}
    readOnly={props.readOnly}
    required={props.required}
    name={props.name}
    items={props.items}
    loading={props.loading}
  >{props.children}</BaseInputListRoot>
}

export component ComboboxRoot(props: Parameters<typeof BaseComboboxRoot>[0]) {
  <BaseComboboxRoot
    value={props.value}
    defaultValue={props.defaultValue}
    onValueChange={props.onValueChange}
    multiple={props.multiple}
    values={props.values}
    defaultValues={props.defaultValues}
    onValuesChange={props.onValuesChange}
    inputValue={props.inputValue}
    defaultInputValue={props.defaultInputValue}
    onInputValueChange={props.onInputValueChange}
    open={props.open}
    defaultOpen={props.defaultOpen}
    onOpenChange={props.onOpenChange}
    filter={props.filter}
    autoHighlight={props.autoHighlight}
    loop={props.loop}
    openOnInputClick={props.openOnInputClick}
    disabled={props.disabled}
    readOnly={props.readOnly}
    required={props.required}
    name={props.name}
    items={props.items}
    loading={props.loading}
  >{props.children}</BaseComboboxRoot>
}

export component ComboboxInput(props: Parameters<typeof BaseComboboxInput>[0]) {
  <BaseComboboxInput {...props} data-glaze="combobox-input" />
}

export component ComboboxTrigger(props: Parameters<typeof BaseComboboxTrigger>[0]) {
  <BaseComboboxTrigger {...props} data-glaze="combobox-trigger">{props.children}</BaseComboboxTrigger>
}

export component ComboboxClear(props: Parameters<typeof BaseComboboxClear>[0]) {
