import { TableOfContentsRoot, TableOfContentsLink, TableOfContentsIndicator } from "../../src/glaze/table-of-contents.rx"

export default component Example() {
  source article: HTMLElement | undefined := undefined
  action setArticle(element: HTMLElement) { article := element }
  <div class="grid w-full grid-cols-2 gap-3">
    <TableOfContentsRoot aria-label="On this page" container={article} offset={56}>
      <p class="mb-1 text-sm font-semibold">On this page</p>
      <ul class="grid gap-1">
        <li><TableOfContentsLink href="#toc-hero-water">Water</TableOfContentsLink></li>
        <li>
          <TableOfContentsLink href="#toc-hero-leaves">Leaves</TableOfContentsLink>
          <ul class="mt-1 grid gap-1 ps-3">
            <li><TableOfContentsLink href="#toc-hero-measuring">Measuring</TableOfContentsLink></li>
            <li><TableOfContentsLink href="#toc-hero-storing">Storing</TableOfContentsLink></li>
          </ul>
        </li>
        <li><TableOfContentsLink href="#toc-hero-steeping">Steeping</TableOfContentsLink></li>
        <li><TableOfContentsLink href="#toc-hero-serving">Serving</TableOfContentsLink></li>
      </ul>
      <TableOfContentsIndicator />
    </TableOfContentsRoot>
    <div class="h-64 space-y-3 overflow-auto rounded-control border border-border p-3 text-sm" tabindex="0" ref={setArticle}>
      <header class="font-semibold">Brewing guide</header>
      <p>A short guide to making a better pot, from the kettle to the cup.</p>
      <h3 class="scroll-mt-2 font-semibold" id="toc-hero-water">Water</h3>
      <p>Soft water lets the flavour through. If the kettle scales up quickly, try filtered water for a week and compare.</p>
      <p>Green teas want water well below boiling, around 75 to 80 degrees. Hotter water draws out bitterness quickly.</p>
      <h3 class="scroll-mt-2 font-semibold" id="toc-hero-leaves">Leaves</h3>
      <p>Whole leaves give a rounder cup than broken ones, and they can be steeped more than once.</p>
      <h4 class="scroll-mt-2 font-semibold" id="toc-hero-measuring">Measuring</h4>
      <p>Measure by weight rather than by spoon: large, open leaves fill a spoon with far less tea than small, rolled ones.</p>
      <h4 class="scroll-mt-2 font-semibold" id="toc-hero-storing">Storing</h4>
      <p>Store leaves away from light, heat and strong smells, in a container that closes well.</p>
      <h3 class="scroll-mt-2 font-semibold" id="toc-hero-steeping">Steeping</h3>
      <p>Black teas take water just off the boil and three to five minutes. Taste at three, then decide.</p>
      <p>Oolongs reward several short infusions. Start at thirty seconds and add ten for each round after.</p>
      <p>Warm the pot first. A cold pot takes the heat out of the water before the leaves have had a chance to open.</p>
      <h3 class="scroll-mt-2 font-semibold" id="toc-hero-serving">Serving</h3>
      <p>Pour all of it out once it is ready, so the last cup isn't stewed.</p>
    </div>
  </div>
}
