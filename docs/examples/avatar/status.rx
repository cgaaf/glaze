import { Button } from "../../../src/glaze/button.rx"
import { AvatarRoot, AvatarImage, AvatarFallback } from "../../../src/glaze/avatar.rx"

export default component ProfileImage() {
  source available := true
  source status := ""
  portrait = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='%233e805f'/><circle cx='20' cy='16' r='7' fill='%23fff'/><path d='M5 40a15 15 0 0 1 30 0' fill='%23fff'/></svg>"
  <div class="flex flex-wrap items-center gap-3">
    <AvatarRoot>
      <AvatarImage src={available ? portrait : "data:image/png;base64,AAAA"} alt="Sam Rivera" onLoadingStatusChange={(next) => { status := next }} />
      <AvatarFallback delay={250}>SR</AvatarFallback>
    </AvatarRoot>
    <Button variant="outline" onClick={() => { available := !available }}>{available ? "Try a broken image" : "Restore image"}</Button>
    <output class="text-sm text-muted-foreground">Image status: {status}</output>
  </div>
}
