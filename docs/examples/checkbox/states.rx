import { Button } from "../../../src/glaze/button.rx"
import { CheckboxRoot, CheckboxIndicator } from "../../../src/glaze/checkbox.rx"

export default component CheckboxStates() {
  source mixed := true
  <div class="grid min-w-0 gap-2">
    <label class="flex flex-wrap items-center gap-2 text-sm">
      <CheckboxRoot indeterminate={mixed} onCheckedChange={() => { mixed := false }}><CheckboxIndicator /></CheckboxRoot>
      Indeterminate until pressed
    </label>
    <label class="flex flex-wrap items-center gap-2 text-sm">
      <CheckboxRoot disabled><CheckboxIndicator /></CheckboxRoot>
      Disabled
    </label>
    <label class="flex flex-wrap items-center gap-2 text-sm">
      <CheckboxRoot disabled defaultChecked><CheckboxIndicator /></CheckboxRoot>
      Disabled and checked
    </label>
    <label class="flex flex-wrap items-center gap-2 text-sm">
      <CheckboxRoot readOnly defaultChecked><CheckboxIndicator /></CheckboxRoot>
      Read-only
    </label>
    <div class="mt-2">
      <Button variant="outline" size="sm" type="button" disabled={mixed} onClick={() => { mixed := true }}>Make it indeterminate again</Button>
    </div>
  </div>
}
