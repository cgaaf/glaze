import { AlertDialogRoot, AlertDialogTrigger, AlertDialogPopup, AlertDialogTitle, AlertDialogDescription, AlertDialogClose, AlertDialogFooter } from "../../src/glaze/alert-dialog.rx"

export default component Example() {
  <div class="grid max-w-full gap-2">
    <AlertDialogRoot>
      <AlertDialogTrigger>Discard draft</AlertDialogTrigger>
      <AlertDialogPopup>
        <AlertDialogTitle>Discard draft?</AlertDialogTitle>
        <AlertDialogDescription>You can't undo this action. The draft and its attachments will be removed.</AlertDialogDescription>
        <AlertDialogFooter>
          <AlertDialogClose variant="ghost">Cancel</AlertDialogClose>
          <AlertDialogClose variant="destructive">Discard</AlertDialogClose>
        </AlertDialogFooter>
      </AlertDialogPopup>
    </AlertDialogRoot>
  </div>
}
