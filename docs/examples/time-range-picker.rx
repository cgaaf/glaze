import { Icon } from "../../src/glaze/icon.rx"
import { TimeRangePickerRoot, TimeRangePickerStart, TimeRangePickerEnd, TimeRangePickerSeparator } from "../../src/glaze/time-range-picker.rx"
import { TimePickerField, TimePickerTrigger, TimePickerPopup, TimePickerHours, TimePickerMinutes, TimePickerDayPeriod } from "../../src/glaze/time-picker.rx"
import { TimeFieldInput, TimeFieldSegment } from "../../src/glaze/time-field.rx"
import { timeField } from "../../src/bisque/time-field/time-field.rx"
import { parseTime } from "../../src/bisque/internal/date.js"

component Segments() {
  c = use timeField
  {for segment in c.segments {
    <TimeFieldSegment segment={segment} />
  }}
}

// Opening hours: a start and an end, each its own picker with its own popup, in one labelled group. The end's popup
// disables what would put it before the start; an end typed earlier marks the range invalid.
export default component Example() {
  <div class="grid max-w-full gap-2">
    <span class="text-sm font-medium" id="time-range-picker-hero-label">Opening hours</span>
    <TimeRangePickerRoot aria-labelledby="time-range-picker-hero-label" locale="en-US" minuteStep={15} defaultValue={{ start: parseTime("09:00"), end: parseTime("17:30") }}>
      <TimeRangePickerStart>
        <TimePickerField aria-label="Opens">
          <TimeFieldInput><Segments /></TimeFieldInput>
          <TimePickerTrigger aria-label="Choose opening time">
            <Icon name="clock" />
          </TimePickerTrigger>
        </TimePickerField>
        <TimePickerPopup sideOffset={6}>
          <div class="flex items-start gap-2">
            <TimePickerHours />
            <TimePickerMinutes />
            <TimePickerDayPeriod />
          </div>
        </TimePickerPopup>
      </TimeRangePickerStart>
      <TimeRangePickerSeparator>–</TimeRangePickerSeparator>
      <TimeRangePickerEnd>
        <TimePickerField aria-label="Closes">
          <TimeFieldInput><Segments /></TimeFieldInput>
          <TimePickerTrigger aria-label="Choose closing time">
            <Icon name="clock" />
          </TimePickerTrigger>
        </TimePickerField>
        <TimePickerPopup sideOffset={6}>
          <div class="flex items-start gap-2">
            <TimePickerHours />
            <TimePickerMinutes />
            <TimePickerDayPeriod />
          </div>
        </TimePickerPopup>
      </TimeRangePickerEnd>
    </TimeRangePickerRoot>
  </div>
}
