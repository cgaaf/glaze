import { InputGroup } from "../../src/glaze/input-group.rx"
import { FieldRoot, FieldLabel } from "../../src/glaze/field.rx"
import { ComboboxRoot, ComboboxInput, ComboboxTrigger, ComboboxPopup, ComboboxEmpty, ComboboxList, ComboboxItem, ComboboxItemIndicator } from "../../src/glaze/combobox.rx"

// One option, with its check mark. A component of your own keeps the list short to write.
component Fruit(props: { value: string; label: string }) {
  <ComboboxItem value={props.value} label={props.label}>
    {props.label}
    <ComboboxItemIndicator />
  </ComboboxItem>
}

export default component Example() {
  <div class="grid max-w-full gap-2">
    <FieldRoot>
      <FieldLabel>Fruit</FieldLabel>
      <ComboboxRoot>
        <InputGroup>
          <ComboboxInput placeholder="Choose a fruit…" />
          <ComboboxTrigger aria-label="Show fruits" />
        </InputGroup>
        <ComboboxPopup>
          <ComboboxEmpty>No fruit found.</ComboboxEmpty>
          <ComboboxList>
            <Fruit value="apple" label="Apple" />
            <Fruit value="apricot" label="Apricot" />
            <Fruit value="banana" label="Banana" />
            <Fruit value="blackberry" label="Blackberry" />
            <Fruit value="cherry" label="Cherry" />
            <Fruit value="fig" label="Fig" />
            <Fruit value="grape" label="Grape" />
            <Fruit value="lemon" label="Lemon" />
            <Fruit value="mango" label="Mango" />
            <Fruit value="pear" label="Pear" />
          </ComboboxList>
        </ComboboxPopup>
      </ComboboxRoot>
    </FieldRoot>
  </div>
}
