import { DialogRoot, DialogTrigger, DialogPopup, DialogTitle, DialogDescription, DialogClose } from "../../src/glaze/dialog.rx"

export default component Example() {
  <div class="grid max-w-full gap-2">
    <DialogRoot>
      <DialogTrigger>Rename project</DialogTrigger>
      <DialogPopup>
        <DialogTitle>Rename project</DialogTitle>
        <DialogDescription>The new name shows everywhere the project is listed.</DialogDescription>
        <label class="grid gap-2 text-sm font-medium">
          Name
          <input class="w-full rounded-control border border-input px-3 py-2 text-sm" value="Northwind roadmap" />
        </label>
        <div class="flex items-center justify-end gap-2">
          <DialogClose>Cancel</DialogClose>
          <DialogClose>Save</DialogClose>
        </div>
      </DialogPopup>
    </DialogRoot>
  </div>
}
