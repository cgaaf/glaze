import { DialogRoot, DialogTrigger, DialogPopup, DialogTitle, DialogDescription, DialogClose, DialogFooter } from "../../src/glaze/dialog.rx"
import { FieldRoot, FieldLabel, FieldControl } from "../../src/glaze/field.rx"

export default component Example() {
  <div class="grid max-w-full gap-2">
    <DialogRoot>
      <DialogTrigger>Rename project</DialogTrigger>
      <DialogPopup>
        <DialogTitle>Rename project</DialogTitle>
        <DialogDescription>The new name shows everywhere the project is listed.</DialogDescription>
        <FieldRoot>
          <FieldLabel>Name</FieldLabel>
          <FieldControl value="Northwind roadmap" />
        </FieldRoot>
        <DialogFooter>
          <DialogClose variant="ghost">Cancel</DialogClose>
          <DialogClose variant="default">Save</DialogClose>
        </DialogFooter>
      </DialogPopup>
    </DialogRoot>
  </div>
}
