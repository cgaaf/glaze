import { Icon } from "../../src/glaze/icon.rx"
import { ToolbarRoot, ToolbarButton, ToolbarLink, ToolbarSeparator } from "../../src/glaze/toolbar.rx"
import { ToggleGroup } from "../../src/glaze/toggle-group.rx"
import { Toggle } from "../../src/glaze/toggle.rx"

export default component Example() {
  <div class="grid max-w-full gap-2">
    <ToolbarRoot aria-label="Formatting">
      <ToggleGroup aria-label="Text style" multiple>
        <Toggle value="bold" aria-label="Bold">
          <Icon name="bold" />
        </Toggle>
        <Toggle value="italic" aria-label="Italic">
          <Icon name="italic" />
        </Toggle>
        <Toggle value="underline" aria-label="Underline">
          <Icon name="underline" />
        </Toggle>
      </ToggleGroup>
      <ToolbarSeparator />
      <ToggleGroup aria-label="Alignment" defaultValue={["left"]}>
        <Toggle value="left" aria-label="Align left">
          <Icon name="align-left" />
        </Toggle>
        <Toggle value="center" aria-label="Align center">
          <Icon name="align-center" />
        </Toggle>
        <Toggle value="right" aria-label="Align right">
          <Icon name="align-right" />
        </Toggle>
      </ToggleGroup>
      <ToolbarSeparator />
      <ToolbarLink href="#history">Edited 4 minutes ago</ToolbarLink>
      <ToolbarButton>Share</ToolbarButton>
    </ToolbarRoot>
  </div>
}
