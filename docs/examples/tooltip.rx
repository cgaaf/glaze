import { Icon } from "../../src/glaze/icon.rx"
import { TooltipProvider, TooltipRoot, TooltipTrigger, TooltipPopup, TooltipArrow } from "../../src/glaze/tooltip.rx"

export default component Example() {
  <div class="grid max-w-full gap-2">
    <TooltipProvider>
      <div class="inline-flex items-center gap-1" role="group" aria-label="Text formatting">
        <TooltipRoot>
          <TooltipTrigger aria-label="Bold">
            <Icon name="bold" />
          </TooltipTrigger>
          <TooltipPopup sideOffset={10}>
            <TooltipArrow />
            Bold
          </TooltipPopup>
        </TooltipRoot>
        <TooltipRoot>
          <TooltipTrigger aria-label="Italic">
            <Icon name="italic" />
          </TooltipTrigger>
          <TooltipPopup sideOffset={10}>
            <TooltipArrow />
            Italic
          </TooltipPopup>
        </TooltipRoot>
        <TooltipRoot>
          <TooltipTrigger aria-label="Underline">
            <Icon name="underline" />
          </TooltipTrigger>
          <TooltipPopup sideOffset={10}>
            <TooltipArrow />
            Underline
          </TooltipPopup>
        </TooltipRoot>
      </div>
    </TooltipProvider>
  </div>
}
