import { TabsRoot, TabsList, TabsTab, TabsPanel, TabsIndicator } from "../../../src/glaze/tabs.rx"

export default component TabsAnimated() {
  <div class="grid min-w-0 gap-3">
    <TabsRoot defaultValue="day">
      <TabsList aria-label="Range">
        <TabsTab value="day">Day</TabsTab>
        <TabsTab value="week">Week</TabsTab>
        <TabsTab value="month">Month</TabsTab>
        <TabsIndicator />
      </TabsList>
      <div class="grid overflow-hidden">
        <TabsPanel class="col-start-1 row-start-1 grid gap-1 motion-safe:transition-opacity motion-safe:duration-200 data-starting-style:opacity-0 data-ending-style:opacity-0" value="day">
          <span class="text-2xl font-medium tabular-nums">1,284</span>
          <span class="text-sm font-medium">visits today</span>
        </TabsPanel>
        <TabsPanel class="col-start-1 row-start-1 grid gap-1 motion-safe:transition-opacity motion-safe:duration-200 data-starting-style:opacity-0 data-ending-style:opacity-0" value="week">
          <span class="text-2xl font-medium tabular-nums">8,930</span>
          <span class="text-sm font-medium">visits this week</span>
        </TabsPanel>
        <TabsPanel class="col-start-1 row-start-1 grid gap-1 motion-safe:transition-opacity motion-safe:duration-200 data-starting-style:opacity-0 data-ending-style:opacity-0" value="month">
          <span class="text-2xl font-medium tabular-nums">37,502</span>
          <span class="text-sm font-medium">visits this month</span>
        </TabsPanel>
      </div>
    </TabsRoot>
  </div>
