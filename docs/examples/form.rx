import { Button } from "../../src/glaze/button.rx"
import { Icon } from "../../src/glaze/icon.rx"
import { Form } from "../../src/glaze/form.rx"
import { FieldRoot, FieldLabel, FieldDescription, FieldError } from "../../src/glaze/field.rx"
import { Input } from "../../src/glaze/input.rx"
import { CheckboxRoot, CheckboxIndicator } from "../../src/glaze/checkbox.rx"
import { form } from "../../src/bisque/form/form.rx"
import { createAccount } from "../lib/form-server.js"

component CreateAccountButton() {
  state = use form
  <Button type="submit" disabled={state?.submitting}>
    {if state?.submitting {
      <span aria-hidden="true" class="size-4 rounded-full border-2 border-current border-e-transparent motion-safe:animate-spin" />
      <span>Creating account…</span>
    } else {
      <span>Create account</span>
    }}
  </Button>
}

export default component Example() {
  source created := ""
  source failure := ""
  <div class="grid max-w-full gap-2">
    <Form class="group" onFormSubmit={(values) => {
      // Shown at once: a write before the `await` would otherwise wait for the action to end.
      onFlush(() => { failure := ""; created := "" })
      try {
        // Resolves to the errors the server found, keyed by field name, or to nothing.
        let refused = await createAccount(values)
        if (!refused) { created := `${values.username}` }
        return refused
      } catch (error) {
        failure := error.message
      }
    }}>
      <FieldRoot name="email">
        <FieldLabel>Email</FieldLabel>
        <Input type="email" autocomplete="email" spellcheck={false} required />
        <FieldError />
      </FieldRoot>
      <FieldRoot name="username" validate={(value) => `${value}`.includes(" ") ? "Use letters and digits, no spaces" : null}>
        <FieldLabel>Username</FieldLabel>
        <Input autocomplete="username" spellcheck={false} required minlength={3} />
        <FieldDescription>Try “studio”, or “offline” for a failed request.</FieldDescription>
        <FieldError />
      </FieldRoot>
      <FieldRoot name="terms">
        <div class="flex items-center gap-2">
          <CheckboxRoot required>
            <CheckboxIndicator>
              <Icon name="check" />
            </CheckboxIndicator>
          </CheckboxRoot>
          <FieldLabel>I accept the terms</FieldLabel>
        </div>
        <FieldError>Accept the terms to create an account.</FieldError>
      </FieldRoot>
      <CreateAccountButton />
    </Form>
    <p class="text-sm text-destructive" role="alert" hidden={failure == ""}>{failure}</p>
    <p class="text-sm text-primary" role="status" hidden={created == ""}>Account created for {created}.</p>
  </div>
}
