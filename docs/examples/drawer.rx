import { Icon } from "../../src/glaze/icon.rx"
import { DrawerRoot, DrawerTrigger, DrawerPopup, DrawerContent, DrawerTitle, DrawerDescription, DrawerClose, DrawerFooter } from "../../src/glaze/drawer.rx"
import { FieldsetRoot, FieldsetLegend } from "../../src/glaze/fieldset.rx"
import { CheckboxRoot, CheckboxIndicator } from "../../src/glaze/checkbox.rx"

component Option(props: { label: string; checked?: boolean }) {
  <label class="flex items-center gap-2 text-sm">
    <CheckboxRoot defaultChecked={props.checked}>
      <CheckboxIndicator>
        <Icon name="check" />
      </CheckboxIndicator>
    </CheckboxRoot>
    {props.label}
  </label>
}

export default component Example() {
  <div class="grid max-w-full gap-2">
    <DrawerRoot>
      <DrawerTrigger>Open filters</DrawerTrigger>
      <DrawerPopup>
        <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-muted" />
        <DrawerContent>
          <DrawerTitle>Filters</DrawerTitle>
          <DrawerDescription>Swipe down, press outside or press Done to close.</DrawerDescription>
          <FieldsetRoot>
            <FieldsetLegend>Availability</FieldsetLegend>
            <div class="grid gap-2">
              <Option label="In stock" checked />
              <Option label="Ships this week" />
              <Option label="Pick up in store" />
            </div>
          </FieldsetRoot>
          <DrawerFooter>
            <DrawerClose variant="default">Done</DrawerClose>
          </DrawerFooter>
        </DrawerContent>
      </DrawerPopup>
    </DrawerRoot>
  </div>
}
